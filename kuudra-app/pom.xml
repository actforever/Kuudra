<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.actforever</groupId>
        <artifactId>kuudra</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>kuudra-app</artifactId>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
            <resource><directory>src/main/resources-filtered</directory><filtering>true</filtering></resource>
        </resources>
    </build>
    <dependencies>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-state</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-logging</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.actforever</groupId>
            <artifactId>kuudra-i18n</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
