<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.actforever</groupId>
    <artifactId>kuudra</artifactId>
    <version>v0.4.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>kuudra-api</module>
        <module>kuudra-i18n</module>
        <module>kuudra-logging</module>
        <module>kuudra-config</module>
        <module>kuudra-state</module>
        <module>kuudra-plugin</module>
        <module>kuudra-runtime</module>
        <module>kuudra-app</module>
        <module>kuudra-web</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.17.2</jackson.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <mybatis.version>3.5.19</mybatis.version>
        <lombok.version>1.18.46</lombok.version>
        <skipTests>true</skipTests>

        <!-- 第三方库版本 -->
<!--        <jnativehook.version>2.2.2</jnativehook.version>-->
        <jetbrains-annotations.version>13.0</jetbrains-annotations.version>

        <!-- SpringBoot 版本 -->
        <spring-boot.version>3.3.3</spring-boot.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId><artifactId>mybatis</artifactId><version>${mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- JNativeHook -->
<!--            <dependency>-->
<!--                <groupId>com.github.kwhat</groupId>-->
<!--                <artifactId>jnativehook</artifactId>-->
<!--                <version>${jnativehook.version}</version>-->
<!--            </dependency>-->

            <!-- JetBrains annotations -->
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${jetbrains-annotations.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- workflow core -->
<!--            <dependency>-->
<!--                <groupId>cc.pineclone</groupId>-->
<!--                <artifactId>eventflow-core</artifactId>-->
<!--                <version>${project.version}</version>-->
<!--            </dependency>-->

            <!-- 用户控制标准 -->
<!--            <dependency>-->
<!--                <groupId>cc.pineclone</groupId>-->
<!--                <artifactId>eventflow-user-interaction-spec</artifactId>-->
<!--                <version>${project.version}</version>-->
<!--            </dependency>-->

        </dependencies>
    </dependencyManagement>

    <!-- 修复 Github Action Maven仓库拉取问题 -->
    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 编译器 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration><release>${maven.compiler.release}</release></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <skipTests>${skipTests}</skipTests>
                    </configuration>
                </plugin>

                <!-- 打包器 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
